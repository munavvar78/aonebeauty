# MongoDB Atlas
MONGODB_URI=
MONGODB_DB_NAME=aonebeauty

# Auth.js (generate with: openssl rand -base64 32)
AUTH_SECRET=
ADMIN_EMAIL=
# Used only by npm run db:seed to create/update the admin user
ADMIN_PASSWORD=

# AWS S3 product images
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=aonebeauty-product-images
# Optional CDN / custom public base (otherwise https://{bucket}.s3.{region}.amazonaws.com)
# S3_PUBLIC_BASE_URL=https://dxxxx.cloudfront.net

# Razorpay
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
